SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback
SESSION_SECRET=replace-with-a-long-random-string
SONGTWIN_GRAPH_API_KEY=
MUSICBRAINZ_USER_AGENT=SongTwin/0.1 (you@example.com)

# Firebase client config for account login. Enable Email/Password auth in Firebase.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin credentials for server-side token verification and Firestore.
# Prefer FIREBASE_SERVICE_ACCOUNT_BASE64 on Vercel. It should be the full service
# account JSON encoded as base64. Alternatively use the three split values below.
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Stripe subscription billing. Create a $4.99/month recurring Price in Stripe.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Optional admin-code access. Prefer storing a SHA-256 hash instead of plaintext.
# Generate with: read -s CODE; node -e "const crypto=require('node:crypto'); console.log(crypto.createHash('sha256').update(process.argv[1]).digest('hex'))" "$CODE"
SONGTWIN_ADMIN_CODE_HASH=
